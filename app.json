{
  "expo": {
    "name": "Timemory",
    "slug": "time-memory",
    "scheme": "time-memory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ffz.timememory"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sqlite",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2A1F30",
          "image": "./assets/splash.png",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
